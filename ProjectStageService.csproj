<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProjectStageService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools/**" />
    <Content Remove="tools/**" />
    <None Remove="tools/**" />
    <Content Remove="publish/**" />
    <None Remove="publish/**" />
    <Content Remove="release_*/**" />
    <None Remove="release_*/**" />
    <Content Remove="frontend-parallel/**" />
    <None Remove="frontend-parallel/**" />
    <Content Remove="server-monitor-agent-*/**" />
    <None Remove="server-monitor-agent-*/**" />
    <Content Remove="*.zip" />
    <None Remove="*.zip" />
    <Content Remove="*.tar.gz" />
    <None Remove="*.tar.gz" />
  </ItemGroup>
</Project>
